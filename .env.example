AI_PROVIDER=mock
DATABASE_URL=postgresql+psycopg://escalate:escalate@postgres:5432/escalate
AUTO_ROUTE_CONFIDENCE=0.90
CONFIRMATION_CONFIDENCE=0.70
ROUTING_SECURITY_THRESHOLD=0.80
ROUTING_ENGINEERING_THRESHOLD=0.80
ROUTING_HIGH_IMPACT_THRESHOLD=0.85
ROUTING_HIGH_URGENCY_THRESHOLD=0.80
ROUTING_L3_COMPLEXITY_THRESHOLD=0.65
ROUTING_L2_COMPLEXITY_THRESHOLD=0.35
VITE_API_URL=http://localhost:8000

# Single-account HubSpot Private App (never commit the real token)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_TICKETS_PATH=/crm/v3/objects/tickets
HUBSPOT_SYNC_PAGE_SIZE=100
HUBSPOT_TITLE_PROPERTY=subject
HUBSPOT_DESCRIPTION_PROPERTY=content
HUBSPOT_CUSTOMER_NAME_PROPERTY=
